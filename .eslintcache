\freelance\\bhrc\\src\\redux\\actions\\staticPage.actions.ts",[],"C:\\Users\\kazim\\Work\\freelance\\bhrc\\src\\redux\\reducers\\staticPage.reducer.ts",[],"C:\\Users\\kazim\\Work\\freelance\\bhrc\\src\\components\\Pages\\StaticPage\\StaticPage.tsx",[],"C:\\Users\\kazim\\Work\\freelance\\bhrc\\src\\components\\Pages\\Statements\\Statements.tsx",["435"],"C:\\Users\\kazim\\Work\\freelance\\bhrc\\src\\models\\statement.model.ts",[],"C:\\Users\\kazim\\Work\\freelance\\bhrc\\src\\redux\\types\\statement.types.ts",[],"C:\\Users\\kazim\\Work\\freelance\\bhrc\\src\\redux\\actions\\statement.actions.ts",[],"C:\\Users\\kazim\\Work\\freelance\\bhrc\\src\\redux\\reducers\\statement.reducer.ts",[],"C:\\Users\\kazim\\Work\\freelance\\bhrc\\src\\components\\Pages\\Statements\\Statement.tsx",["436"],"C:\\Users\\kazim\\Work\\freelance\\bhrc\\src\\redux\\reducers\\orgDocs.reducer.ts",[],"C:\\Users\\kazim\\Work\\freelance\\bhrc\\src\\components\\Pages\\OrganizationDocs\\OrganizationDoc.tsx",["437","438"],"C:\\Users\\kazim\\Work\\freelance\\bhrc\\src\\components\\Pages\\OrganizationDocs\\OrganizationDocs.tsx",["439"],"C:\\Users\\kazim\\Work\\freelance\\bhrc\\src\\redux\\actions\\orgDocs.actions.ts",[],"C:\\Users\\kazim\\Work\\freelance\\bhrc\\src\\models\\orgDocs.model.ts",[],"C:\\Users\\kazim\\Work\\freelance\\bhrc\\src\\redux\\types\\orgDocs.types.ts",[],"C:\\Users\\kazim\\Work\\freelance\\bhrc\\src\\components\\Pages\\Urbanica\\Urbanica.tsx",[],"C:\\Users\\kazim\\Work\\freelance\\bhrc\\src\\components\\Pages\\Activities\\News.tsx",[],"C:\\Users\\kazim\\Work\\freelance\\bhrc\\src\\components\\Pages\\Profile\\Profile.tsx",[],"C:\\Users\\kazim\\Work\\freelance\\bhrc\\src\\components\\Pages\\Default.tsx",[],"C:\\Users\\kazim\\Work\\freelance\\bhrc\\src\\components\\UI\\ScrollPage.tsx",["440","441","442","443","444"],"C:\\Users\\kazim\\Work\\freelance\\bhrc\\src\\components\\UI\\ScrollPageContainer.tsx",["445","446"],"import React, { FunctionComponent, useEffect, useState } from \"react\";\r\n\r\nconst ScrollPageContainer: FunctionComponent = (props) => {\r\n    const bodyHeight = window.innerHeight;\r\n    \r\n    const [startPosition, setStartPosition] = useState<number>(0);\r\n    const [scrolled, setScrolled] = useState<number>(0);\r\n    const [scrollTrigger, setTrigger] = useState<boolean>(false);\r\n    const currTime = new Date();\r\n\r\n    const handleScroll = (e: Event) => {\r\n        const newTime = new Date();\r\n        if (newTime.getTime() - currTime.getTime() > 500 && startPosition + bodyHeight < bodyHeight * 4) {\r\n            setScrolled(window.scrollY - startPosition);\r\n            setTrigger(true);\r\n        } else {\r\n            setTrigger(false);\r\n        }\r\n    };\r\n\r\n    useEffect(() => {\r\n        window.addEventListener('scroll', handleScroll);\r\n        return () => window.removeEventListener('scroll', handleScroll);\r\n    }, [window.scrollY]);\r\n\r\n    useEffect(() => {\r\n        if (scrolled > 0) {\r\n            const scrollEnd: number = startPosition === 0 ? bodyHeight - 150 : startPosition + bodyHeight - 90;\r\n            scrollTo(scrollEnd).then(() => {\r\n                setStartPosition(scrollEnd);\r\n                setTrigger(false);\r\n            });\r\n        }\r\n        else if (scrolled < 0) {\r\n            const scrollEnd = startPosition === bodyHeight - 150 ? 0 : startPosition - bodyHeight + 90;\r\n            scrollTo(scrollEnd).then(() => {\r\n                setStartPosition(scrollEnd);\r\n                setTrigger(false);\r\n            });\r\n        }\r\n    }, [scrollTrigger]);\r\n\r\n    const scrollTo = async (position: number) => {\r\n        const prom = new Promise((resolve, reject) => {\r\n            setTimeout(() => {\r\n                resolve(window.scrollTo({behavior: 'smooth', top: position}));\r\n            }, 200);\r\n        });\r\n        return prom;\r\n    }\r\n\r\n    return (\r\n        <>\r\n            {props.children}\r\n        </>\r\n    );\r\n}\r\n\r\nexport default ScrollPageContainer;",["447","448"],"C:\\Users\\kazim\\Work\\freelance\\bhrc\\src\\components\\Pages\\Main\\SonicBot.tsx",[],{"ruleId":"449","severity":1,"message":"450","line":66,"column":47,"nodeType":"451","endLine":66,"endColumn":141},{"ruleId":"452","severity":1,"message":"453","line":11,"column":19,"nodeType":"454","messageId":"455","endLine":11,"endColumn":27},{"ruleId":"452","severity":1,"message":"456","line":30,"column":13,"nodeType":"454","messageId":"455","endLine":30,"endColumn":14},{"ruleId":"452","severity":1,"message":"457","line":1,"column":36,"nodeType":"454","messageId":"455","endLine":1,"endColumn":47},{"ruleId":"452","severity":1,"message":"458","line":1,"column":49,"nodeType":"454","messageId":"455","endLine":1,"endColumn":58},{"ruleId":"452","severity":1,"message":"459","line":1,"column":60,"nodeType":"454","messageId":"455","endLine":1,"endColumn":66},{"ruleId":"452","severity":1,"message":"460","line":4,"column":10,"nodeType":"454","messageId":"455","endLine":4,"endColumn":19},{"ruleId":"452","severity":1,"message":"460","line":3,"column":10,"nodeType":"454","messageId":"455","endLine":3,"endColumn":19},{"ruleId":"452","severity":1,"message":"461","line":16,"column":26,"nodeType":"454","messageId":"455","endLine":16,"endColumn":31},{"ruleId":"452","severity":1,"message":"461","line":14,"column":26,"nodeType":"454","messageId":"455","endLine":14,"endColumn":31},{"ruleId":"462","severity":1,"message":"463","line":22,"column":7,"nodeType":"464","endLine":22,"endColumn":9,"suggestions":"465"},{"ruleId":"462","severity":1,"message":"466","line":27,"column":7,"nodeType":"464","endLine":27,"endColumn":9,"suggestions":"467"},{"ruleId":"468","severity":1,"message":"469","line":16,"column":7,"nodeType":"454","messageId":"470","endLine":16,"endColumn":41},{"ruleId":"462","severity":1,"message":"466","line":27,"column":7,"nodeType":"464","endLine":27,"endColumn":9,"suggestions":"471"},{"ruleId":"462","severity":1,"message":"463","lin